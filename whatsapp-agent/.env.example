PORT=8080
PUBLIC_BASE_URL=https://your-app.example.com

# Meta Cloud API — created after Coexistence / WhatsApp product setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_GRAPH_VERSION=v23.0

# OpenAI-compatible model. Groq example:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional: email/phone shown when the bot hands off to a human
HANDOFF_CONTACT=stay@hospitality.partners / +27836458313
DATA_DIR=./data
