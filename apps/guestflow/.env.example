# GuestFlow Environment Variables
# Copy to .env.local for development

# Staff-only password for production access (required for guestflow.thebrowns.co.za)
STAFF_PASSWORD=your-secure-password-here

# Database URL (for production - use Turso/Cloudflare D1/Fly.io PostgreSQL)
# For localhost, SQLite file will be used automatically (data/guestflow.db)
# For Vercel + Turso: libsql://browns-guestflow-[...].turso.io
DATABASE_URL=

# Turso auth token (required if using DATABASE_URL with Turso)
TURSO_AUTH_TOKEN=

# WhatsApp Cloud API Configuration (Meta / Facebook)
# 
# SANDBOX MODE (default when credentials missing):
# - Set WHATSAPP_MODE=sandbox OR leave credentials empty
# - All sends return success without calling live Meta API
# - Safe for demos, testing, and development
# - Staff flows, approve→draft, portal, and Nightsbridge sync keep working
#
# LIVE MODE (requires approved Business Profile):
# - Set WHATSAPP_MODE=live AND provide all credentials below
# - Obtain from Meta Business Manager after WhatsApp Cloud API setup
# - Only enable after Business Profile approval (typically 1-3 days)
# - See: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
#
# Switching to live:
# 1. Complete Meta Business Profile approval
# 2. Purchase SA phone number from approved provider
# 3. Link number to WhatsApp Business Account
# 4. Test with Twilio magic number (+15005550006) first
# 5. Set WHATSAPP_MODE=live and add credentials below
WHATSAPP_MODE=sandbox
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Cron Secret for Autonomous Ingest
# Required for /api/cron/nightsbridge-ingest endpoint
# Generate a secure random string (e.g., openssl rand -hex 32)
CRON_SECRET=

# Inbound WhatsApp Webhook Secret (NEW)
# Required for securing the /api/inbound/webhook endpoint
# Used to authenticate messages from CoS bridge/Twilio/manual paste
# Generate with: openssl rand -base64 32
INBOUND_WEBHOOK_SECRET=

# Node environment
NODE_ENV=development

# Contact Form Configuration (for /api/public/contact)
# Email notification recipient (where contact form submissions go)
CONTACT_RECIPIENT_EMAIL=stay@thebrowns.co.za

# Option 1: Resend API (recommended for Vercel)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@guestflow.thebrowns.co.za

# Option 2: SMTP Configuration (alternative to Resend)
# Use if you have your own SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@thebrowns.co.za

# Guest Portal Configuration
# Property contact details shown in guest portal
PROPERTY_PHONE=
PROPERTY_EMAIL=grant@thebrowns.co.za
PROPERTY_WHATSAPP=
EMERGENCY_CONTACT=

# WiFi credentials (shown to guests in their stay portal)
WIFI_NETWORK=
WIFI_PASSWORD=

# Access codes (time-gated: shown 24h before check-in through checkout)
PROPERTY_GATE_CODE=
PROPERTY_DOOR_CODE=

# Parking instructions
PROPERTY_PARKING=

# Property directions (shown to guests)
PROPERTY_DIRECTIONS=
