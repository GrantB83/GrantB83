# GuestFlow Environment Variables
# Copy to .env.local for development

# Staff-only password for production access (required for guestflow.thebrowns.co.za)
STAFF_PASSWORD=your-secure-password-here

# Database URL (for production - use Turso/Cloudflare D1/Fly.io PostgreSQL)
# For localhost, SQLite file will be used automatically (data/guestflow.db)
# For Vercel + Turso: libsql://browns-guestflow-[...].turso.io
DATABASE_URL=

# Turso auth token (required if using DATABASE_URL with Turso)
TURSO_AUTH_TOKEN=

# WhatsApp Messaging Configuration
# 
# PROVIDER SELECTION:
# - WHATSAPP_MODE=sandbox OR incomplete provider creds → sandbox dry-run (no real sends)
# - WHATSAPP_PROVIDER=twilio OR auto-detect Twilio creds → Twilio Messaging API (live)
# - Meta credentials present (no Twilio) → Meta WhatsApp Cloud API (live)
#
# SANDBOX MODE (default when credentials missing):
# - Set WHATSAPP_MODE=sandbox OR leave all credentials empty
# - All sends return success without calling external API
# - Safe for demos, testing, and development
# - Staff flows, approve→draft, portal, and Nightsbridge sync keep working
#
# TWILIO LIVE MODE (recommended - approved Business Profile ready):
# - Set WHATSAPP_PROVIDER=twilio OR provide Twilio credentials (auto-detect)
# - Obtain credentials from Twilio Console (https://console.twilio.com)
# - Twilio WhatsApp Business Profile must be approved first
# - Supports whatsapp:+E164 or +E164 format (auto-normalized)
#
# META LIVE MODE (original - requires Meta Business Profile approval):
# - Provide Meta credentials below (used when Twilio creds absent)
# - Obtain from Meta Business Manager after WhatsApp Cloud API setup
# - Only enable after Business Profile approval (typically 1-3 days)
# - See: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
#
# MODE SELECTION (optional - auto-detects based on credentials)
WHATSAPP_MODE=sandbox
WHATSAPP_PROVIDER=

# TWILIO CREDENTIALS (for Twilio Messaging API)
# Required for live sends via Twilio:
# - TWILIO_ACCOUNT_SID: Account SID from Twilio Console
# - TWILIO_AUTH_TOKEN: Auth Token from Twilio Console
# - TWILIO_WHATSAPP_FROM: Your Twilio WhatsApp sender (e.g., whatsapp:+14155238886 or +14155238886)
# Optional:
# - TWILIO_MESSAGING_SERVICE_SID: Use Messaging Service instead of From number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# META CREDENTIALS (for Meta WhatsApp Cloud API)
# Required for live sends via Meta (when Twilio creds not present):
# - WHATSAPP_TOKEN: Access token from Meta Business Manager
# - WHATSAPP_PHONE_NUMBER_ID: Phone number ID from WhatsApp Business Account
# - WHATSAPP_BUSINESS_ACCOUNT_ID: Business account ID from Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Cron Secret for Autonomous Ingest
# Required for /api/cron/nightsbridge-ingest endpoint
# Generate a secure random string (e.g., openssl rand -hex 32)
CRON_SECRET=

# Inbound WhatsApp Webhook Secret (NEW)
# Required for securing the /api/inbound/webhook endpoint
# Used to authenticate messages from CoS bridge/Twilio/manual paste
# Generate with: openssl rand -base64 32
INBOUND_WEBHOOK_SECRET=

# Node environment
NODE_ENV=development

# Contact Form Configuration (for /api/public/contact)
# Email notification recipient (where contact form submissions go)
CONTACT_RECIPIENT_EMAIL=stay@thebrowns.co.za

# Option 1: Resend API (recommended for Vercel)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@guestflow.thebrowns.co.za

# Option 2: SMTP Configuration (alternative to Resend)
# Use if you have your own SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@thebrowns.co.za

# Guest Portal Configuration
# Property contact details shown in guest portal
PROPERTY_PHONE=
PROPERTY_EMAIL=grant@thebrowns.co.za
PROPERTY_WHATSAPP=
EMERGENCY_CONTACT=

# Guest Portal Base URL (optional)
# When set, all magic links and guest-facing URLs will use this domain
# Example: https://stay.thebrowns.co.za
# If not set, defaults to current host (guestflow.thebrowns.co.za)
# This enables splitting guest portal onto a separate domain for public access
# while keeping staff ops on guestflow.thebrowns.co.za
NEXT_PUBLIC_PORTAL_BASE_URL=

# WiFi credentials (shown to guests in their stay portal)
WIFI_NETWORK=
WIFI_PASSWORD=

# Access codes (time-gated: shown 24h before check-in through checkout)
PROPERTY_GATE_CODE=
PROPERTY_DOOR_CODE=

# Parking instructions
PROPERTY_PARKING=

# Property directions (shown to guests)
PROPERTY_DIRECTIONS=
