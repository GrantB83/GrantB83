# GuestFlow Environment Variables
# Copy to .env.local for development

# Staff-only password for production access (required for guestflow.thebrowns.co.za)
STAFF_PASSWORD=your-secure-password-here

# Database URL (for production - use Turso/Cloudflare D1/Fly.io PostgreSQL)
# For localhost, SQLite file will be used automatically (data/guestflow.db)
# For Vercel + Turso: libsql://browns-guestflow-[...].turso.io
DATABASE_URL=

# Turso auth token (required if using DATABASE_URL with Turso)
TURSO_AUTH_TOKEN=

# WhatsApp Cloud API Configuration (Meta / Facebook)
# Required for sending WhatsApp messages via the Approve & Send button
# Obtain these from Meta Business Manager after setting up WhatsApp Cloud API
# See: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Nightsbridge Autonomous Sync Configuration
# For /api/ops/nightsbridge-sync endpoint (triggered by Vercel Cron)
# Auth secret for cron endpoint (generate with: openssl rand -hex 32)
CRON_SECRET=your-secure-random-string-here

# Tenant ID for Nightsbridge imports (default: 1 for The Browns Dullstroom)
NIGHTSBRIDGE_TENANT_ID=1

# Google Drive folder ID for drop-folder sync (optional)
# If set, cron will check this folder for new arr_and_dep.xlsx files
# Format: folder ID from Drive URL (e.g., 1a2b3c4d5e6f7g8h9i0j)
# Leave empty to disable Drive sync (manual upload via /ops/nightsbridge-import still works)
NIGHTSBRIDGE_DRIVE_FOLDER_ID=

# Node environment
NODE_ENV=development

