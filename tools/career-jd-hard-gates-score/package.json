{
  "name": "career-jd-hard-gates-score",
  "version": "1.0.0",
  "description": "Offline CLI to score job descriptions against career hard gates and proof points",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "score": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/parser.test.js dist/gates.test.js dist/scorer.test.js",
    "score": "node dist/index.js",
    "test:fixtures": "npm run build && node dist/test-fixtures.js",
    "clean": "rm -rf dist test-out out"
  },
  "keywords": ["career", "job", "scoring", "gates", "operations"],
  "author": "Grant Brown",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
