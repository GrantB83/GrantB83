{
  "name": "career-cover-letter-facts-lint",
  "version": "1.0.0",
  "description": "Offline CLI to lint cover letter drafts against allowed facts from career-os",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lint": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/extractor.test.js dist/matcher.test.js",
    "lint": "node dist/index.js",
    "test:fixtures": "npm run build && node dist/test-fixtures.js",
    "clean": "rm -rf dist test-out out"
  },
  "keywords": ["career", "cover-letter", "facts", "lint", "operations"],
  "author": "Grant Brown",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
